# Copiez ce fichier en .env et renseignez les valeurs pour activer les plateformes.

PORT=8765
HOST=0.0.0.0

# Discord Activities / OAuth (obligatoire pour jouer dans Discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# URL publique HTTPS de l'Activity (tunnel cloudflared / Render / …)
DISCORD_REDIRECT_URI=
# URL racine mappée dans le portail (ex. https://xxxx.discordsays.com)
# DISCORD_PUBLIC_URL=

# Telegram Mini App
TELEGRAM_BOT_NAME=
TELEGRAM_APP_NAME=

# Facebook Instant Games / Login
FACEBOOK_APP_ID=

# PeerJS (par défaut : cloud public)
PEERJS_HOST=0.peerjs.com
PEERJS_PORT=443
PEERJS_PATH=/
PEERJS_SECURE=true

# Serveurs ICE optionnels (JSON). Ajoutez un TURN pour les NAT difficiles
# (obligatoire derrière certains box / mobiles / Discord Activity).
# Exemple Metered / coturn :
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# API KataGo optionnelle (POST JSON {sgf,size,komi,maxVisits})
# KATAGO_URL=https://votre-serveur/katago/analyze

ALLOW_DISCORD_MOCK=true
